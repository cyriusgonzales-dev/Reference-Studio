{
  "name": "vmix-reference-studio",
  "productName": "Vmix Reference Studio",
  "version": "0.1.0",
  "description": "Research browser and single-output presentation app for live webinars captured by vMix.",
  "main": "./out/main/index.js",
  "author": "Vmix Reference Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icon": "node scripts/generate-icon.mjs",
    "package": "npm run build && electron-builder --win --x64",
    "package:dir": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
